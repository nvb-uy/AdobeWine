 }
 
-static BOOL get_portal_policy_value(WCHAR *buffer, DWORD size)
-{
-    return wine_get_appdefaults_reg_sz(L"X11 Driver", L"FileDialogPortal", buffer, size);
-}
-
-static enum portal_policy get_portal_policy(void)
-{

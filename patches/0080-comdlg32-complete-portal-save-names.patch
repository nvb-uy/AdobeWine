+static void portal_complete_name(FileDialogImpl *This, WCHAR *path, UINT size)
+{
+    const WCHAR *spec = This->filterspec_count ? This->filterspecs[This->filetypeindex].pszSpec : NULL;
+    WCHAR extbuf[MAX_PATH], *ext = NULL;
+
+    if (!This->default_ext) return;
+    if (*PathFindExtensionW(path) && spec && PathMatchSpecW(PathFindFileNameW(path), spec)) return;
+    if (spec) ext = get_first_ext_from_spec(extbuf, spec);
+    if (!ext)
+    {
+        swprintf(extbuf, ARRAY_SIZE(extbuf), L".%s", This->default_ext);
+        ext = extbuf;
+    }
+    if (lstrlenW(path) + lstrlenW(ext) < size) lstrcatW(path, ext);
+    TRACE("completed to %s\n", debugstr_w(path));
+}
+
+static HRESULT portal_set_results(FileDialogImpl *This, const WCHAR *paths, UINT count)
+{
+    PIDLIST_ABSOLUTE *pidls;
+    HRESULT hr;
+    UINT i;
+
+    if (!(pidls = calloc(count, sizeof(*pidls)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++, paths += lstrlenW(paths) + 1)
+        pidls[i] = SHSimpleIDListFromPath(paths);
+
+    if (This->psia_results)
+    {
+        IShellItemArray_Release(This->psia_results);
+        This->psia_results = NULL;
+    }
+    hr = SHCreateShellItemArrayFromIDLists(count, (PCIDLIST_ABSOLUTE_ARRAY)pidls, &This->psia_results);
+
+    for (i = 0; i < count; i++) ILFree(pidls[i]);
+    free(pidls);
+    return hr;
+}
+
+static HRESULT portal_overwrite(FileDialogImpl *This)
+{
+    IShellItem *item;
+    HRESULT hr;
+
+    if (FAILED(hr = IShellItemArray_GetItemAt(This->psia_results, 0, &item))) return hr;
+    hr = events_OnOverwrite(This, item);
+    IShellItem_Release(item);
+    return hr;
+}

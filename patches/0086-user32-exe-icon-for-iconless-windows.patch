From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] user32: Give windows without an icon the executable's icon.

When a window has neither its own nor a class icon, win32u falls back to the Wine logo for the title bar and the icon it hands to the window manager. Use the first icon of the main executable instead, like the taskbar on Windows does, and only use the generic application icon when the executable has none.
---
diff --git a/dlls/user32/user_main.c b/dlls/user32/user_main.c
--- a/dlls/user32/user_main.c
+++ b/dlls/user32/user_main.c
@@ -88,11 +88,40 @@ static NTSTATUS WINAPI User32ImmTranslateMessage( void *args, ULONG size )
     return STATUS_INVALID_PARAMETER;
 }
 
+static HICON get_default_window_icon( int cx, int cy, UINT flags )
+{
+    static HICON icons[2];
+    WCHAR path[MAX_PATH];
+    HICON icon = 0, old;
+    UINT id, index;
+
+    if (!cx) cx = GetSystemMetrics( SM_CXICON );
+    if (!cy) cy = GetSystemMetrics( SM_CYICON );
+    index = cx < GetSystemMetrics( SM_CXICON );
+    if (icons[index]) return icons[index];
+
+    if (!GetModuleFileNameW( 0, path, ARRAY_SIZE(path) ) ||
+        PrivateExtractIconsW( path, 0, cx, cy, &icon, &id, 1, 0 ) != 1 || !icon)
+        return LoadImageW( 0, (const WCHAR *)IDI_APPLICATION, IMAGE_ICON, cx, cy, flags | LR_SHARED );
+
+    if ((old = InterlockedCompareExchangePointer( (void **)&icons[index], icon, NULL )))
+    {
+        DestroyIcon( icon );
+        return old;
+    }
+    return icon;
+}
+
 static NTSTATUS WINAPI User32LoadImage( void *args, ULONG size )
 {
     const struct load_image_params *params = args;
-    HANDLE ret = LoadImageW( params->hinst, params->name, params->type,
-                             params->dx, params->dy, params->flags );
+    HANDLE ret;
+
+    if (!params->hinst && params->name == (const WCHAR *)IDI_WINLOGO && params->type == IMAGE_ICON)
+        ret = get_default_window_icon( params->dx, params->dy, params->flags );
+    else
+        ret = LoadImageW( params->hinst, params->name, params->type,
+                          params->dx, params->dy, params->flags );
     if (!ret) return STATUS_NO_MEMORY;
     return NtCallbackReturn( &ret, sizeof(ret), STATUS_SUCCESS );
 }

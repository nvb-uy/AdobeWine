From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] comdlg32: Match portal filters case-insensitively and return the chosen one.

Windows matches file types without regard to case, so the patterns are sent with bracket expressions and *.* becomes *. The filter selected in the portal comes back as the file type index, with OnTypeChange for IFileDialog, which also gets one before the request like Wine's own dialog does. The filter list may now be 64 KiB long.
---
diff --git a/dlls/comdlg32/filedlg.c b/dlls/comdlg32/filedlg.c
--- a/dlls/comdlg32/filedlg.c
+++ b/dlls/comdlg32/filedlg.c
@@ -4494,6 +4494,8 @@ BOOL WINAPI GetOpenFileNameW(OPENFILENAMEW *ofn)
         }
         else if (status == STATUS_SUCCESS && params->result_buffer_len && params->result_buffer[0])
         {
+            if (params->result_filter)
+                ofn->nFilterIndex = params->result_filter - (ofn->lpstrCustomFilter && *ofn->lpstrCustomFilter);
             TRACE("Portal SUCCESS with result!\n");
             /* Copy packed result to output buffer */
             if (ofn->lpstrFile && params->result_buffer_len <= ofn->nMaxFile)
@@ -4730,6 +4732,8 @@ BOOL WINAPI GetSaveFileNameW(
         }
         else if (status == STATUS_SUCCESS && params->result_buffer[0])
         {
+            if (params->result_filter)
+                ofn->nFilterIndex = params->result_filter - (ofn->lpstrCustomFilter && *ofn->lpstrCustomFilter);
             TRACE("Portal SUCCESS with result!\n");
             /* Copy result to output buffer */
             if (ofn->lpstrFile && lstrlenW(params->result_buffer) + 1 <= ofn->nMaxFile)
diff --git a/dlls/comdlg32/itemdlg.c b/dlls/comdlg32/itemdlg.c
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -2931,6 +2931,15 @@ static void portal_apply_choices(FileDialogImpl *This, const struct portal_choic
     }
 }
 
+static void portal_apply_filter(FileDialogImpl *This, UINT result_filter)
+{
+    if (!result_filter || result_filter > This->filterspec_count || result_filter - 1 == This->filetypeindex)
+        return;
+    This->filetypeindex = result_filter - 1;
+    set_current_filter(This, This->filterspecs[This->filetypeindex].pszSpec);
+    events_OnTypeChange(This);
+}
+
 static HRESULT try_portal_itemdlg(FileDialogImpl *This, HWND hwndOwner)
 {
     struct portal_file_params *open_params = NULL;
@@ -2942,6 +2951,9 @@ static HRESULT try_portal_itemdlg(FileDialogImpl *This, HWND hwndOwner)
     NTSTATUS status;
     HRESULT hr = S_OK;
 
+    if (This->filterspec_count)
+        events_OnTypeChange(This);
+
     if (This->dlg_type == ITEMDLG_TYPE_OPEN)
     {
         WCHAR **paths = NULL;
@@ -2991,6 +3003,7 @@ static HRESULT try_portal_itemdlg(FileDialogImpl *This, HWND hwndOwner)
         {
             const WCHAR *buf = open_params->result_buffer;
 
+            portal_apply_filter(This, open_params->result_filter);
             portal_apply_choices(This, &open_params->choices, choice_map);
 
             if (!(open_params->flags & PORTAL_OPEN_FLAG_MULTIPLE) || open_params->result_count == 1)
@@ -3158,6 +3171,7 @@ static HRESULT try_portal_itemdlg(FileDialogImpl *This, HWND hwndOwner)
 			PIDLIST_ABSOLUTE pidl = NULL;
 			HRESULT hr_array;
 
+			portal_apply_filter(This, save_params->result_filter);
 			portal_apply_choices(This, &save_params->choices, choice_map);
 
 			if (This->psia_results)
diff --git a/dlls/comdlg32/portal_dbus.c b/dlls/comdlg32/portal_dbus.c
--- a/dlls/comdlg32/portal_dbus.c
+++ b/dlls/comdlg32/portal_dbus.c
@@ -125,8 +125,30 @@ struct portal_context
     char **result_uris;         /* file:// URIs from portal */
     UINT result_uri_count;
     struct portal_choices *choices; /* custom controls, selected values filled from the response */
+    char *result_filter;
 };
 
+static char *case_insensitive_glob(const char *pattern)
+{
+    char *glob, *p;
+
+    if (!strcmp(pattern, "*.*")) return strdup("*");
+    if (strchr(pattern, '[') || !(glob = malloc(strlen(pattern) * 4 + 1))) return strdup(pattern);
+    for (p = glob; *pattern; pattern++)
+    {
+        if ((*pattern >= 'a' && *pattern <= 'z') || (*pattern >= 'A' && *pattern <= 'Z'))
+        {
+            *p++ = '[';
+            *p++ = *pattern | 0x20;
+            *p++ = *pattern & ~0x20;
+            *p++ = ']';
+        }
+        else *p++ = *pattern;
+    }
+    *p = 0;
+    return glob;
+}
+
 /* Helper: Split pattern string by semicolons (e.g., "*.txt;*.doc" -> ["*.txt", "*.doc"]) */
 static char **split_pattern(const char *pattern, UINT *count)
 {
@@ -153,7 +175,7 @@ static char **split_pattern(const char *pattern, UINT *count)
                 capacity *= 2;
                 result = realloc(result, capacity * sizeof(char*));
             }
-            result[size++] = strdup(token);
+            result[size++] = case_insensitive_glob(token);
         }
         token = strtok_r(NULL, ";", &saveptr);
     }
@@ -201,7 +223,6 @@ static void append_single_filter(DBusMessageIter *filters_array, const char *nam
     p_dbus_message_iter_close_container(filters_array, &filter_struct);
 }
 
-/* Build filter array option for D-Bus: a(sa(us)) */
 static BOOL get_next_filter_pair(const char **cursor, const char *end,
                                  const char **name, const char **pattern)
 {
@@ -230,6 +251,18 @@ static BOOL get_next_filter_pair(const char **cursor, const char *end,
     return TRUE;
 }
 
+static UINT find_filter(const struct portal_file_params *params, const char *name)
+{
+    const char *cursor = params->filters_blob, *end = params->filters_blob + params->filters_blob_len;
+    const char *filter, *pattern;
+    UINT i;
+
+    if (!name) return 0;
+    for (i = 1; i <= params->filter_count && get_next_filter_pair(&cursor, end, &filter, &pattern); i++)
+        if (!strcmp(filter, name)) return i;
+    return 0;
+}
+
 static void append_current_filter_option(DBusMessageIter *options_dict, const char *name, const char *pattern)
 {
     DBusMessageIter entry, variant, filter_struct, patterns_array, pattern_struct;
@@ -425,6 +458,20 @@ static void parse_choices_result(struct portal_context *ctx, DBusMessageIter *va
     }
 }
 
+static void parse_current_filter(struct portal_context *ctx, DBusMessageIter *variant)
+{
+    DBusMessageIter filter;
+    const char *name;
+
+    if (p_dbus_message_iter_get_arg_type(variant) != DBUS_TYPE_STRUCT) return;
+    p_dbus_message_iter_recurse(variant, &filter);
+    if (p_dbus_message_iter_get_arg_type(&filter) != DBUS_TYPE_STRING) return;
+    p_dbus_message_iter_get_basic(&filter, &name);
+    TRACE("current filter %s\n", debugstr_a(name));
+    free(ctx->result_filter);
+    ctx->result_filter = strdup(name);
+}
+
 /* Signal filter to capture Response from portal */
 static DBusHandlerResult portal_response_filter(DBusConnection *conn, DBusMessage *msg, void *user_data)
 {
@@ -500,7 +547,6 @@ static DBusHandlerResult portal_response_filter(DBusConnection *conn, DBusMessag
         p_dbus_message_iter_recurse(&args, &dict);
 
         /* custom control values; the URI loop below stops at the first URI key */
-        if (ctx->choices)
         {
             DBusMessageIter scan = dict;
 
@@ -510,11 +556,12 @@ static DBusHandlerResult portal_response_filter(DBusConnection *conn, DBusMessag
                 if (p_dbus_message_iter_get_arg_type(&entry) == DBUS_TYPE_STRING)
                 {
                     p_dbus_message_iter_get_basic(&entry, &key);
-                    if (!strcmp(key, "choices") && p_dbus_message_iter_next(&entry) &&
+                    if (p_dbus_message_iter_next(&entry) &&
                         p_dbus_message_iter_get_arg_type(&entry) == DBUS_TYPE_VARIANT)
                     {
                         p_dbus_message_iter_recurse(&entry, &variant);
-                        parse_choices_result(ctx, &variant);
+                        if (!strcmp(key, "choices")) parse_choices_result(ctx, &variant);
+                        else if (!strcmp(key, "current_filter")) parse_current_filter(ctx, &variant);
                     }
                 }
                 p_dbus_message_iter_next(&scan);
@@ -763,6 +810,9 @@ static void portal_cleanup(struct portal_context *ctx)
         ctx->request_path = NULL;
     }
 
+    free(ctx->result_filter);
+    ctx->result_filter = NULL;
+
     if (ctx->result_uris)
     {
         for (i = 0; i < ctx->result_uri_count; i++)
@@ -1124,6 +1174,7 @@ NTSTATUS CDECL portal_open_file(void *args)
                                   params->flags,
                                   &params->choices);
     TRACE("portal_open_file: portal_call_and_wait returned 0x%08x\n", (unsigned int)status);
+    params->result_filter = find_filter(params, ctx.result_filter);
 
     params->result_count = 0;
     params->result_grouped = 0;
@@ -1296,6 +1347,7 @@ NTSTATUS CDECL portal_save_file(void *args)
                                   params->flags,
                                   &params->choices);
     TRACE("portal_save_file: portal_call_and_wait returned 0x%08x\n", (unsigned int)status);
+    params->result_filter = find_filter(params, ctx.result_filter);
 
     params->result_count = 0;
     params->result_grouped = 0;

 }
 
 static HRESULT create_shell_item_array_from_paths(WCHAR **paths, IShellItemArray **ppsia)
@@ -2693,67 +2667,6 @@ static HRESULT create_shell_item_array_from_paths(WCHAR **paths, IShellItemArray
     return hr;
 }
 

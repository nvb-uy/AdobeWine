+static WCHAR *filedlg_portal_names(const WCHAR *paths, UINT count, UINT dir_len)
+{
+    const WCHAR *p;
+    WCHAR *names, *q;
+    UINT i, len = 1;
+
+    for (i = 0, p = paths; i < count; i++, p += lstrlenW(p) + 1) len += lstrlenW(p) + 3;
+    if (!(names = q = malloc(len * sizeof(WCHAR)))) return NULL;
+    *q = 0;
+
+    for (i = 0, p = paths; i < count; i++, p += lstrlenW(p) + 1)
+    {
+        if (wcsnicmp(p, paths, dir_len) || wcschr(p + dir_len, '\\'))
+        {
+            WARN("%s is not in the folder of the first file, dropped\n", debugstr_w(p));
+            continue;
+        }
+        if (count == 1)
+        {
+            lstrcpyW(q, p + dir_len);
+            break;
+        }
+        q += swprintf(q, len - (q - names), L"%s\"%s\"", q == names ? L"" : L" ", p + dir_len);
+    }
+    return names;
+}

From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] gdiplus: Only build the tested part of a region in visibility tests.

GdipIsVisibleRegionRect built the whole region as an HRGN to test one rectangle. Build it only inside the rectangle, and answer FALSE without building anything when the rectangle misses the region's bounding box. With a window sized elliptical clip, 917 tests went from 1982 to 30 ms.
---
diff --git a/dlls/gdiplus/region.c b/dlls/gdiplus/region.c
--- a/dlls/gdiplus/region.c
+++ b/dlls/gdiplus/region.c
@@ -1583,17 +1583,40 @@ GpStatus WINGDIPAPI GdipIsInfiniteRegion(GpRegion *region, GpGraphics *graphics,
  */
 GpStatus WINGDIPAPI GdipIsVisibleRegionRect(GpRegion* region, REAL x, REAL y, REAL w, REAL h, GpGraphics *graphics, BOOL *res)
 {
+    REAL min_x, min_y, max_x, max_y;
+    BOOL empty, infinite;
+    RECT rect, bounds;
     HRGN hrgn;
     GpStatus stat;
-    RECT rect;
 
     TRACE("(%p, %.2f, %.2f, %.2f, %.2f, %p, %p)\n", region, x, y, w, h, graphics, res);
 
     if(!region || !res)
         return InvalidParameter;
 
-    if((stat = GdipGetRegionHRgn(region, NULL, &hrgn)) != Ok)
-        return stat;
+    SetRect(&rect, ceilr(x), ceilr(y), ceilr(x + w), ceilr(y + h));
+    SetRect(&bounds, min(rect.left, rect.right), min(rect.top, rect.bottom),
+            max(rect.left, rect.right), max(rect.top, rect.bottom));
+
+    get_region_bounding_box(&region->node, &min_x, &min_y, &max_x, &max_y, &empty, &infinite);
+
+    if (empty || infinite || IsRectEmpty(&bounds))
+    {
+        if((stat = GdipGetRegionHRgn(region, NULL, &hrgn)) != Ok)
+            return stat;
+    }
+    else
+    {
+        RECT box = { floorf(min_x), floorf(min_y), ceilf(max_x) + 1, ceilf(max_y) + 1 };
+
+        if (!IntersectRect(&bounds, &bounds, &box))
+        {
+            *res = FALSE;
+            return Ok;
+        }
+        if((stat = get_region_hrgn(&region->node, &bounds, &hrgn)) != Ok)
+            return stat;
+    }
 
     /* infinite */
     if(!hrgn){
@@ -1601,7 +1624,6 @@ GpStatus WINGDIPAPI GdipIsVisibleRegionRect(GpRegion* region, REAL x, REAL y, RE
         return Ok;
     }
 
-    SetRect(&rect, ceilr(x), ceilr(y), ceilr(x + w), ceilr(y + h));
     *res = RectInRegion(hrgn, &rect);
 
     DeleteObject(hrgn);

#include <windows.h>

3843 DIALOGEX 0, 0, 300, 70
STYLE WS_CHILD | WS_CLIPSIBLINGS | DS_CONTROL | DS_3DLOOK
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Settings:", -1, 6, 4, 50, 10
    LTEXT "&Slices:", -1, 6, 20, 50, 10
    COMBOBOX 0xbb9, 60, 18, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX 0xbba, 60, 2, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Save &metadata", 0x101, 6, 36, 100, 10
    AUTOCHECKBOX "Greyed out", 0x102, 110, 36, 100, 10, WS_DISABLED
    PUSHBUTTON "Help", 0x103, 220, 2, 50, 14
    AUTORADIOBUTTON "Radio &A", 0x104, 6, 52, 60, 10, WS_GROUP
    AUTORADIOBUTTON "Radio B", 0x105, 70, 52, 60, 10
END

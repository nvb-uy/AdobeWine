+static void filedlg_portal_show(HWND hwnd)
+{
+    FileOpenDlgInfos *info = get_filedlg_infoptr(hwnd);
+    struct portal_file_params *params;
+    WCHAR text[1024], path[MAX_PATH], *names, *slash;
+    LPITEMIDLIST pidl;
+    int i, count, cur;
+    NTSTATUS status;
+    BOOL save;
+
+    if (!info || !info->portal) return;
+    save = !!(info->DlgInfos.dwDlgProp & FODPROP_SAVEDLG);
+    if (!(params = calloc(1, sizeof(*params))))
+    {
+        info->portal = FALSE;
+        ShowWindow(hwnd, SW_SHOWNORMAL);
+        return;
+    }
+
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    portal_utf8(params->title_utf8, sizeof(params->title_utf8), text);
+    if (COMDLG32_GetDisplayNameOf(info->ShellInfos.pidlAbsCurrent, path))
+        portal_unix_path(params->initial_dir_utf8, sizeof(params->initial_dir_utf8), path);
+
+    GetWindowTextW(info->DlgInfos.hwndFileName, text, ARRAY_SIZE(text));
+    if (save && *text && !wcspbrk(text, L"*?\"<>|"))
+    {
+        portal_utf8(params->initial_filename_utf8, sizeof(params->initial_filename_utf8), text);
+        COMDLG32_GetCanonicalPath(info->ShellInfos.pidlAbsCurrent, text, path);
+        portal_unix_path(params->current_file_unix, sizeof(params->current_file_unix), path);
+    }
+
+    count = SendMessageW(info->DlgInfos.hwndFileTypeCB, CB_GETCOUNT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *spec = (const WCHAR *)CBGetItemDataPtr(info->DlgInfos.hwndFileTypeCB, i);
+
+        if (SendMessageW(info->DlgInfos.hwndFileTypeCB, CB_GETLBTEXTLEN, i, 0) >= ARRAY_SIZE(text)) break;
+        SendMessageW(info->DlgInfos.hwndFileTypeCB, CB_GETLBTEXT, i, (LPARAM)text);
+        if ((INT_PTR)spec == CB_ERR || !portal_add_filter(params, text, spec)) break;
+    }
+    cur = SendMessageW(info->DlgInfos.hwndFileTypeCB, CB_GETCURSEL, 0, 0);
+    if (cur >= 0 && cur < params->filter_count) params->current_filter_index = cur + 1;
+
+    if (!save && (info->ofnInfos->Flags & OFN_ALLOWMULTISELECT))
+        params->flags |= PORTAL_OPEN_FLAG_MULTIPLE;
+    params->max_results = (params->flags & PORTAL_OPEN_FLAG_MULTIPLE) ? 1024 : 1;
+
+    status = portal_call(save ? unix_portal_save_file : unix_portal_open_file, params, info->ofnInfos->hwndOwner);
+    TRACE("portal returned %#lx, %u files\n", status, params->result_count);
+
+    if (status == STATUS_CANCELLED || (!status && !params->result_count))
+        SendMessageW(hwnd, WM_COMMAND, IDCANCEL, 0);
+    else if (status)
+    {
+        WARN("portal failed (%#lx), showing the dialog\n", status);
+        info->portal = FALSE;
+        ShowWindow(hwnd, SW_SHOWNORMAL);
+    }
+    else
+    {
+        if (params->result_filter && params->result_filter - 1 != cur)
+        {
+            SendMessageW(info->DlgInfos.hwndFileTypeCB, CB_SETCURSEL, params->result_filter - 1, 0);
+            SendMessageW(hwnd, WM_COMMAND, MAKEWPARAM(IDC_FILETYPE, CBN_SELENDOK),
+                         (LPARAM)info->DlgInfos.hwndFileTypeCB);
+        }
+
+        lstrcpynW(path, params->result_buffer, ARRAY_SIZE(path));
+        if ((slash = wcsrchr(path, '\\'))) slash[1] = 0;
+        if ((pidl = ILCreateFromPathW(path)))
+        {
+            if (!ILIsEqual(pidl, info->ShellInfos.pidlAbsCurrent)) filedlg_browse_to_pidl(info, pidl);
+            ILFree(pidl);
+        }
+
+        if ((names = filedlg_portal_names(params->result_buffer, params->result_count, lstrlenW(path))))
+        {
+            SetWindowTextW(info->DlgInfos.hwndFileName, names);
+            free(names);
+        }
+        lstrcpynW(info->portal_path, params->result_buffer, ARRAY_SIZE(info->portal_path));
+
+        PostMessageW(hwnd, WM_PORTAL_SHOW, 0, 0);
+        info->DlgInfos.dwDlgProp &= ~FODPROP_USEVIEW;
+        FILEDLG95_OnOpen(hwnd);
+    }
+    free(params);
+}

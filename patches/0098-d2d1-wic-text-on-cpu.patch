From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] d2d1: Draw clears and grayscale glyph runs of WIC bitmap targets on the CPU.

WIC bitmap targets now keep a copy of their pixels in memory. Clears and aliased 1x1 glyph runs with a solid brush are drawn into that copy, using the same fixed-point conversion and blend the GPU produces, and EndDraw hands it to the WIC bitmap without a readback. Anything that reads or draws the texture uploads the copy first, after which the target stays on the GPU until the next readback. Photoshop's Home screen draws every text element into its own small WIC target and waited for a GPU readback on each EndDraw.
---
diff --git a/dlls/d2d1/bitmap.c b/dlls/d2d1/bitmap.c
--- a/dlls/d2d1/bitmap.c
+++ b/dlls/d2d1/bitmap.c
@@ -101,6 +101,7 @@ static ULONG STDMETHODCALLTYPE d2d_bitmap_Release(ID2D1Bitmap1 *iface)
             ID3D11Texture2D_Release(bitmap->msaa_load_texture);
         ID3D11Resource_Release(bitmap->resource);
         ID2D1Factory_Release(bitmap->factory);
+        free(bitmap->cpu_data);
         free(bitmap);
     }
 
@@ -182,6 +183,66 @@ void d2d_bitmap_msaa_invalidate(struct d2d_bitmap *bitmap)
         bitmap->msaa_state = D2D_MSAA_INVALID;
 }
 
+BYTE *d2d_bitmap_cpu_bits(struct d2d_bitmap *bitmap)
+{
+    if (!bitmap->cpu_enabled)
+        return NULL;
+    if (!bitmap->cpu_data && !(bitmap->cpu_data = malloc(bitmap->pixel_size.width * bitmap->pixel_size.height * 4)))
+        bitmap->cpu_enabled = FALSE;
+    return bitmap->cpu_data;
+}
+
+void d2d_bitmap_cpu_upload(struct d2d_bitmap *bitmap)
+{
+    ID3D11DeviceContext *context;
+    ID3D11Device *device;
+
+    if (bitmap->cpu_state != D2D_CPU_DIRTY)
+        return;
+
+    ID3D11Resource_GetDevice(bitmap->resource, &device);
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_UpdateSubresource(context, bitmap->resource, 0, NULL, bitmap->cpu_data,
+            bitmap->pixel_size.width * 4, 0);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(device);
+    d2d_bitmap_msaa_invalidate(bitmap);
+    bitmap->cpu_state = D2D_CPU_SYNC;
+}
+
+void d2d_bitmap_cpu_disable(struct d2d_bitmap *bitmap)
+{
+    d2d_bitmap_cpu_upload(bitmap);
+    free(bitmap->cpu_data);
+    bitmap->cpu_data = NULL;
+    bitmap->cpu_enabled = FALSE;
+    bitmap->cpu_state = D2D_CPU_NONE;
+}
+
+BOOL d2d_bitmap_cpu_read(struct d2d_bitmap *bitmap, BYTE *dst, unsigned int pitch)
+{
+    unsigned int i, row = bitmap->pixel_size.width * 4;
+
+    if (bitmap->cpu_state == D2D_CPU_NONE)
+        return FALSE;
+
+    for (i = 0; i < bitmap->pixel_size.height; ++i)
+        memcpy(dst + i * pitch, bitmap->cpu_data + i * row, row);
+    return TRUE;
+}
+
+void d2d_bitmap_cpu_store(struct d2d_bitmap *bitmap, const BYTE *src, unsigned int pitch)
+{
+    unsigned int i, row = bitmap->pixel_size.width * 4;
+
+    if (!bitmap->cpu_data)
+        return;
+
+    for (i = 0; i < bitmap->pixel_size.height; ++i)
+        memcpy(bitmap->cpu_data + i * row, src + i * pitch, row);
+    bitmap->cpu_state = D2D_CPU_SYNC;
+}

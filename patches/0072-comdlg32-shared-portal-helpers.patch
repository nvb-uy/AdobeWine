+
+WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
+
+enum portal_policy portal_get_policy(void)
+{
+    const char *env = getenv("WINE_FORCE_PORTAL");
+    WCHAR value[32];
+
+    if (env && *env == '1') return PORTAL_POLICY_FORCE;
+    if (env && *env == '0') return PORTAL_POLICY_NEVER;
+
+    if (wine_get_appdefaults_reg_sz(L"X11 Driver", L"FileDialogPortal", value, sizeof(value)))
+    {
+        if (!wcsicmp(value, L"always")) return PORTAL_POLICY_FORCE;
+        if (!wcsicmp(value, L"auto")) return PORTAL_POLICY_AUTO;
+    }
+    return PORTAL_POLICY_NEVER;
+}
+
+NTSTATUS portal_call(enum comdlg32_unix_funcs code, struct portal_file_params *params)
+{
+    NTSTATUS status;
+
+    if (!COMDLG32_init_unix_call()) return STATUS_NOT_SUPPORTED;
+    status = WINE_UNIX_CALL(code, params);
+    TRACE("call %u returned %#lx\n", code, status);
+    return status;
+}
+
+BOOL portal_available(void)
+{
+    struct portal_is_available_params params = {0};
+
+    return COMDLG32_init_unix_call() && !WINE_UNIX_CALL(unix_portal_is_available, &params);
+}
+
+void portal_utf8(char *dst, size_t size, const WCHAR *str)
+{
+    if (!size) return;
+    dst[0] = 0;
+    if (!str) return;
+    if (!WideCharToMultiByte(CP_UTF8, 0, str, -1, dst, size, NULL, NULL))
+    {
+        int len = WideCharToMultiByte(CP_UTF8, 0, str, -1, NULL, 0, NULL, NULL);
+        char *tmp = len > 0 ? malloc(len) : NULL;
+
+        if (!tmp) return;
+        WideCharToMultiByte(CP_UTF8, 0, str, -1, tmp, len, NULL, NULL);
+        lstrcpynA(dst, tmp, size);
+        free(tmp);
+    }
+}
+
+void portal_unix_path(char *dst, size_t size, const WCHAR *path)
+{
+    char *unix_path;
+
+    if (!size) return;
+    dst[0] = 0;
+    if (!path || !*path) return;
+
+    if (!(unix_path = wine_get_unix_file_name(path))) return;
+    lstrcpynA(dst, unix_path, size);
+    HeapFree(GetProcessHeap(), 0, unix_path);
+}
+
+BOOL portal_add_filter(struct portal_file_params *params, const WCHAR *name, const WCHAR *spec)
+{
+    UINT size = sizeof(params->filters_blob), pos = params->filters_blob_len;
+    int name_len, spec_len;
+
+    if (pos) pos--;
+    name_len = WideCharToMultiByte(CP_UTF8, 0, name, -1, NULL, 0, NULL, NULL);
+    spec_len = WideCharToMultiByte(CP_UTF8, 0, spec, -1, NULL, 0, NULL, NULL);
+    if (name_len <= 0 || spec_len <= 0 || pos + name_len + spec_len + 1 > size)
+    {
+        WARN("no room for filter %s\n", debugstr_w(name));
+        return FALSE;
+    }
+
+    WideCharToMultiByte(CP_UTF8, 0, name, -1, params->filters_blob + pos, name_len, NULL, NULL);
+    pos += name_len;
+    WideCharToMultiByte(CP_UTF8, 0, spec, -1, params->filters_blob + pos, spec_len, NULL, NULL);
+    pos += spec_len;
+    params->filters_blob[pos++] = 0;
+    params->filters_blob_len = pos;
+    params->filter_count++;
+    return TRUE;
+}
